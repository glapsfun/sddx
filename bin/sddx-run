#!/bin/sh
# sddx launcher: Bun only. There is deliberately no fallback runtime.
#
# Receipts record which runtime executed an oracle, and that claim only means
# something if the supported set is small and enforced. A second runtime would
# double the tested matrix and let a receipt be produced that a Bun-only
# maintainer cannot reproduce.
if [ "$#" -lt 1 ]; then
  echo "usage: sddx-run <script> [args...]" >&2
  exit 64
fi
if ! command -v bun >/dev/null 2>&1; then
  echo "sddx: bun is required and was not found on PATH." >&2
  echo "sddx: install it with: curl -fsSL https://bun.sh/install | bash" >&2
  echo "sddx: other install methods: https://bun.sh/docs/installation" >&2
  exit 1
fi
exec bun "$@"
